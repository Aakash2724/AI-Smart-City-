# ==============================================================================
# AI Smart City Platform - Environment Configuration Template
# ==============================================================================

# Database Connection (SQLite default for easy local dev)
DATABASE_URL=sqlite:///./smart_city.db

# Groq API Key for Llama / Qwen NLP & Vision Multi-Agent Pipeline
GROQ_API_KEY=""

# Google Gemini API Key for Gemini-2.5-Flash Multimodal Analysis
GEMINI_API_KEY=""

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=""

# Active LLM Provider preference ("gemini", "groq", "openai", or "mock")
LLM_PROVIDER=gemini

# ==============================================================================
# Transactional Email APIs & SMTP Citizen Email Dispatch
# ==============================================================================
# Option 1: Modern Transactional Email API (Resend)
RESEND_API_KEY=""

# SendGrid API (Optional)
SENDGRID_API_KEY=""

# Brevo API (Optional)
BREVO_API_KEY=""

# Option 2: System SMTP (Simple Mail Transfer Protocol) Server
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="SmartGov AI Municipal Redressal"
SMTP_USE_TLS=true
